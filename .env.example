# ===================================================================
# Wedding RSVP Spring Boot REST API - Environment Configuration Example
# Copy this file to .env or export these variables in your environment.
# Never commit real production credentials to version control.
# ===================================================================

# Port on which the Spring Boot application will listen (default: 8080)
PORT=8080

# PostgreSQL JDBC URL
# Format: jdbc:postgresql://<host>:<port>/<database_name>
DB_URL=jdbc:postgresql://localhost:5432/wedding_db

# PostgreSQL Database Credentials
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Allowed React Frontend Origin for Cross-Origin Resource Sharing (CORS)
# Supports comma-separated origins for dev and prod:
# e.g., http://localhost:5173,https://wedding.example.com
FRONTEND_URL=http://localhost:5173
